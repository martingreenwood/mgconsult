# Calendly API Configuration
# Get your personal access token from: https://calendly.com/integrations/api_webhooks
VITE_CALENDLY_API_TOKEN=your_calendly_api_token_here

# Your Calendly user URI (get this from the API or your Calendly account)
# Format: https://api.calendly.com/users/AAAAAAAAAAAAAAAA
VITE_CALENDLY_USER_URI=https://api.calendly.com/users/your_user_id_here

# Your Calendly username/slug for generating embed URLs
# This is the part after calendly.com/ in your booking links
VITE_CALENDLY_USER_SLUG=your-calendly-username

# Default event type slug for consultations
# This is the part after your username in your booking links
VITE_CALENDLY_CONSULTATION_EVENT_SLUG=consultation

# Statamic/Laravel backend used for content and contact form submissions
VITE_CONTENT_API_BASE_URL=https://api.martingreenwood.com

# Optional explicit overrides if the contact endpoints live somewhere else
VITE_CSRF_COOKIE_URL=https://api.martingreenwood.com/sanctum/csrf-cookie
VITE_CONTACT_API_URL=https://api.martingreenwood.com/api/contact
